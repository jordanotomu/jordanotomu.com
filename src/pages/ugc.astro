---
import BaseLayout from "~/layouts/BaseLayout.astro";

// best-of numbers only; no handles, post links or per-video detail
// (the accounts stay anonymous).
const stats = [
    { value: "250M+", label: "total views" },
    { value: "120K+", label: "followers across platforms" },
    { value: "10M+", label: "views on a single video" },
];

// dashboard screenshots — src null = placeholder until the crop is in
const results = [
    {
        src: "/assets/ugc/yt-studio-28d.jpg",
        alt: "YouTube Studio, last 28 days",
        outcome: "25M+ views in a single month on YouTube Shorts.",
    },
    {
        src: "/assets/ugc/tiktok-365d.jpg",
        alt: "TikTok Studio, last 365 days",
        outcome: "85M+ views and 5M+ likes on TikTok in a year.",
    },
];

const programs = [
    {
        name: "Cantina",
        logo: "/assets/logos/cantina.png",
        wordmark: true,
        dates: "Sep 2026 – now",
    },
    {
        name: "Halo AI",
        logo: "/assets/logos/halo.png",
        dates: "Jan – May 2026",
    },
    {
        name: "Arcads",
        logo: "/assets/logos/arcads.jpg",
        dates: "Mar 2026",
    },
];
---

<BaseLayout
    title="UGC · Jordan Otomu"
    description="Jordan Otomu — $30K/mo AI-prank UGC creator with 250M+ views, and the engineer behind FakeChat, the tool that makes the videos."
>
    <fieldset class="box">
        <legend><i>cat ~/ugc/README.md</i></legend>
        <p class="ugc-kicker">ugc · growth · tools</p>
        <h2 class="ugc-headline">
            <span class="big">$30K/mo</span> ugc creator. ai prank videos for
            consumer apps, made with a tool i built.
        </h2>
        <div class="ugc-links">
            <a class="btn" href="/">software side →</a>
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>ls ~/ugc/numbers</i></legend>
        <div class="stat-row">
            {stats.map((s) => (
                <div class="stat">
                    <b>{s.value}</b>
                    <span>{s.label}</span>
                </div>
            ))}
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>open ~/ugc/results</i></legend>
        <div class="results">
            {results.map((r) => (
                <figure class="result">
                    {r.src ? (
                        <img src={r.src} alt={r.alt} loading="lazy" />
                    ) : (
                        <div class="shot-ph"><span class="ph-label">{r.alt}</span></div>
                    )}
                    <figcaption>{r.outcome}</figcaption>
                </figure>
            ))}
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>cat ~/ugc/fakechat.md</i></legend>
        <div class="tool">
            <div class="tool-text">
                <h2>FakeChat</h2>
                <p>
                    the editor behind every video. script an imessage-style
                    conversation, drop in an ai photo or video hook, and export a
                    ready-to-post 1080×2160 mp4 that looks like a phone screen
                    recording. the live preview plays exactly what gets exported.
                </p>
                <p>
                    other creators in the programs use it too. it's free.
                </p>
                <div class="ugc-links">
                    <a class="btn" href="https://project-fcz9u.vercel.app" target="_blank" rel="noopener">try fakechat →</a>
                </div>
            </div>
            <img class="tool-shot" src="/assets/ugc/fakechat-editor.jpg" alt="FakeChat editor: hook and script panels with a live phone preview" loading="lazy" />
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>cat ~/ugc/format.md</i></legend>
        <ol class="format">
            <li><b>the hook.</b> an ai-edited photo or clip that looks real, on screen in the first second.</li>
            <li><b>the escalation.</b> a parent or boss reacts over text and spirals into ALL-CAPS panic.</li>
            <li><b>the reveal.</b> "it's fake, i made it with [app]." the product is the punchline, not an ad read.</li>
        </ol>
    </fieldset>

    <fieldset class="box">
        <legend><i>ls ~/ugc/brands</i></legend>
        <div class="brands">
            {programs.map((p) => (
                <div class="brand">
                    <div class="brand-logo">
                        <img
                            class:list={[{ wordmark: p.wordmark }]}
                            src={p.logo}
                            alt={`${p.name} logo`}
                            loading="lazy"
                        />
                    </div>
                    <div class="brand-mark">{p.name}</div>
                    <div class="brand-dates">{p.dates}</div>
                </div>
            ))}
            <div class="brand brand-open">
                <div class="brand-logo"><span class="brand-slot">+</span></div>
                <div class="brand-mark">your app</div>
                <div class="brand-dates">let's talk</div>
            </div>
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>mail jordan</i></legend>
        <p>
            ugc for your app, campaign or creator management, or the
            fakechat-style format and tooling for your team.
        </p>
        <div class="email-row">
            <code class="email" id="ugc-email">jordanotomu@gmail.com</code>
            <button class="btn" type="button" id="copy-email">copy</button>
        </div>
    </fieldset>
</BaseLayout>

<script>
    const btn = document.getElementById("copy-email");
    btn?.addEventListener("click", async () => {
        const text = document.getElementById("ugc-email")?.textContent ?? "";
        try {
            await navigator.clipboard.writeText(text);
            btn.textContent = "copied";
        } catch {
            btn.textContent = "select it ↑";
        }
        setTimeout(() => (btn.textContent = "copy"), 1600);
    });
</script>

<style>
    .ugc-kicker {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 6px;
    }
    .ugc-headline {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 24px;
        line-height: 1.3;
        max-width: 30ch;
        margin-bottom: 14px;
    }
    .ugc-headline .big {
        display: block;
        font-size: 64px;
        line-height: 1;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
    }
    .ugc-intro { max-width: 62ch; }
    .ugc-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }

    /* ============ numbers ============ */
    .stat-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }
    .stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
        border-left: 1px solid var(--faint);
        padding-left: 12px;
    }
    .stat:first-child { border-left: none; padding-left: 0; }
    .stat b {
        font-family: var(--font-mono);
        font-size: 30px;
        line-height: 1.1;
    }
    .stat span {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    /* ============ placeholders ============ */
    .ph-label {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        text-align: center;
        padding: 0 10px;
    }

    /* ============ results ============ */
    .results {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .result { margin: 0; }
    .result img {
        width: 100%;
        display: block;
        border: 1px solid var(--border);
    }
    .shot-ph {
        aspect-ratio: 16 / 10;
        display: grid;
        place-items: center;
        border: 1px dashed var(--border);
        background: repeating-linear-gradient(
            135deg,
            var(--faint) 0 1px,
            transparent 1px 10px
        );
    }
    .result figcaption {
        font-size: 14px;
        margin-top: 8px;
    }

    /* ============ fakechat ============ */
    .tool {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: 24px;
        align-items: start;
    }
    .tool h2 {
        font-family: var(--font-mono);
        font-size: 20px;
        margin-bottom: 8px;
    }
    .tool-shot {
        width: 100%;
        display: block;
        border: 1px solid var(--border);
    }

    /* ============ format ============ */
    .format {
        list-style: none;
        counter-reset: step;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .format li {
        counter-increment: step;
        position: relative;
        padding-left: 34px;
        max-width: 64ch;
    }
    .format li::before {
        content: "0" counter(step);
        position: absolute;
        left: 0;
        top: 1px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--muted);
    }

    /* ============ brands ============ */
    .brands {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }
    .brand {
        border: 1px solid var(--border);
        padding: 14px;
    }
    .brand-logo {
        height: 40px;
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }
    .brand-logo img {
        height: 40px;
        width: 40px;
        border-radius: 9px;
        object-fit: cover;
    }
    .brand-logo img.wordmark {
        width: auto;
        border-radius: 0;
        object-fit: contain;
    }
    .brand-slot {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border: 1px dashed var(--border);
        border-radius: 9px;
        font-family: var(--font-mono);
        font-size: 20px;
        color: var(--muted);
    }
    .brand-mark {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 18px;
    }
    .brand-dates {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 2px;
    }
    .brand-open { border-style: dashed; }

    /* ============ contact ============ */
    .email-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 14px;
        flex-wrap: wrap;
    }
    .email {
        font-family: var(--font-mono);
        font-size: 17px;
        padding: 7px 12px;
        border: 1px solid var(--border);
        user-select: all;
    }

    @media (max-width: 720px) {
        .ugc-headline { font-size: 19px; }
        .ugc-headline .big { font-size: 48px; }
        .stat b { font-size: 22px; }
        .results { grid-template-columns: 1fr; }
        .tool { grid-template-columns: 1fr; }
        .brands { grid-template-columns: 1fr 1fr; }
    }
</style>
