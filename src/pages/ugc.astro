---
import BaseLayout from "~/layouts/BaseLayout.astro";

// best-of numbers only; no handles, post links or per-video detail
// (the accounts stay anonymous).
const stats = [
    { value: "250M+", label: "views in 6 months" },
    { value: "120K+", label: "followers" },
    { value: "16.1M", label: "on one video" },
];

// dashboard screenshots — src null = placeholder until the crop is in
const results = [
    {
        src: "/assets/ugc/yt-studio-28d.jpg",
        alt: "YouTube Studio, last 28 days",
        outcome: "25M+ views in a single month on YouTube Shorts.",
    },
    {
        src: "/assets/ugc/tiktok-365d.jpg",
        alt: "TikTok Studio, last 365 days",
        outcome: "85M+ views and 5M+ likes on TikTok in a year.",
    },
    {
        src: "/assets/ugc/fb-2026.jpg",
        alt: "Facebook insights, this year",
        outcome: "65M+ views on Facebook this year.",
    },
    {
        src: "/assets/ugc/sideshift-oct.jpg",
        alt: "SideShift earnings history, October 2026",
        outcome: "$29K+ earned in October from one app program.",
    },
];

const programs = [
    {
        name: "Cantina",
        logo: "/assets/logos/cantina.png",
        wordmark: true,
        dates: "Sep 2026 – now",
    },
    {
        name: "Halo AI",
        logo: "/assets/logos/halo.png",
        dates: "Jan 2026 – now",
    },
    {
        name: "Arcads",
        logo: "/assets/logos/arcads.jpg",
        dates: "Mar 2026",
    },
    { name: "Undisclosed brand", nda: true, dates: "under NDA" },
    { name: "Undisclosed brand", nda: true, dates: "under NDA" },
] as { name: string; logo?: string; dates: string; wordmark?: boolean; nda?: boolean }[];
---

<BaseLayout
    title="UGC · Jordan Otomu"
    description="Jordan Otomu — $30K/mo UGC creator. AI prank videos for consumer apps, 250M+ views."
>
    <fieldset class="box">
        <legend><i>cat ~/ugc/README.md</i></legend>
        <p class="ugc-kicker">ugc · growth · tools</p>
        <h2 class="ugc-headline">
            <span class="big">$30K/mo</span> ugc creator. ai prank videos for
            consumer apps.
        </h2>
        <div class="ugc-links">
            <a class="btn" href="/classic">software side →</a>
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>ls ~/ugc/numbers</i></legend>
        <div class="stat-row">
            {stats.map((s) => (
                <div class="stat">
                    <b>{s.value}</b>
                    <span>{s.label}</span>
                </div>
            ))}
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>open ~/ugc/results</i></legend>
        <div class="results">
            {results.map((r) => (
                <figure class="result">
                    {r.src ? (
                        <img src={r.src} alt={r.alt} loading="lazy" />
                    ) : (
                        <div class="shot-ph"><span class="ph-label">{r.alt}</span></div>
                    )}
                    <figcaption>{r.outcome}</figcaption>
                </figure>
            ))}
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>ls ~/ugc/tools</i></legend>
        <div class="tool">
            <div class="tool-text">
                <p>
                    i build my own ugc tools. <b>fakechat</b> is the one i use most:
                    script an imessage-style chat, add an ai hook, export a
                    ready-to-post video. free to use.
                </p>
                <div class="ugc-links">
                    <a class="btn" href="https://project-fcz9u.vercel.app" target="_blank" rel="noopener">fakechat →</a>
                </div>
            </div>
            <picture>
                <source media="(max-width: 720px)" srcset="/assets/ugc/fakechat-phone.jpg" />
                <img class="tool-shot" src="/assets/ugc/fakechat-editor.jpg" alt="FakeChat: a chat script plays as a phone screen recording" loading="lazy" />
            </picture>
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>ls ~/ugc/brands</i></legend>
        <div class="brands">
            {programs.map((p) => (
                <div class="brand">
                    <div class="brand-logo">
                        {p.nda ? (
                            <span class="brand-slot nda">NDA</span>
                        ) : (
                            <img
                                class:list={[{ wordmark: p.wordmark }]}
                                src={p.logo}
                                alt={`${p.name} logo`}
                                loading="lazy"
                            />
                        )}
                    </div>
                    <div class="brand-mark">{p.name}</div>
                    <div class="brand-dates">{p.dates}</div>
                </div>
            ))}
            <div class="brand brand-open">
                <div class="brand-logo"><span class="brand-slot">+</span></div>
                <div class="brand-mark">your app</div>
                <div class="brand-dates">let's talk</div>
            </div>
        </div>
    </fieldset>

    <fieldset class="box">
        <legend><i>mail jordan</i></legend>
        <p>
            ugc for your app, campaign or creator management, and ugc
            tools.
        </p>
        <div class="email-row">
            <code class="email" id="ugc-email">jordanotomu@gmail.com</code>
            <button class="btn" type="button" id="copy-email">copy</button>
        </div>
    </fieldset>
</BaseLayout>

<script>
    const btn = document.getElementById("copy-email");
    btn?.addEventListener("click", async () => {
        const text = document.getElementById("ugc-email")?.textContent ?? "";
        try {
            await navigator.clipboard.writeText(text);
            btn.textContent = "copied";
        } catch {
            btn.textContent = "select it ↑";
        }
        setTimeout(() => (btn.textContent = "copy"), 1600);
    });
</script>

<style>
    .ugc-kicker {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 6px;
    }
    .ugc-headline {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 24px;
        line-height: 1.3;
        max-width: 30ch;
        margin-bottom: 14px;
    }
    .ugc-headline .big {
        display: block;
        font-size: 64px;
        line-height: 1;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
    }
    .ugc-intro { max-width: 62ch; }
    .ugc-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }

    /* ============ numbers ============ */
    .stat-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }
    .stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
        border-left: 1px solid var(--faint);
        padding-left: 12px;
    }
    .stat:first-child { border-left: none; padding-left: 0; }
    .stat b {
        font-family: var(--font-mono);
        font-size: 30px;
        line-height: 1.1;
    }
    .stat span {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    /* ============ placeholders ============ */
    .ph-label {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        text-align: center;
        padding: 0 10px;
    }

    /* ============ results ============ */
    .results {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
    }
    .result { margin: 0; }
    .result img {
        width: 100%;
        display: block;
        border: 1px solid var(--border);
    }
    .shot-ph {
        aspect-ratio: 16 / 10;
        display: grid;
        place-items: center;
        border: 1px dashed var(--border);
        background: repeating-linear-gradient(
            135deg,
            var(--faint) 0 1px,
            transparent 1px 10px
        );
    }
    .result figcaption {
        font-size: 14px;
        margin-top: 8px;
    }

    /* ============ fakechat ============ */
    .tool {
        display: grid;
        gap: 16px;
    }
    .tool-shot {
        width: 100%;
        display: block;
        border: 1px solid var(--border);
    }
    @media (max-width: 720px) {
        .tool-shot { max-width: 240px; margin: 0 auto; border-radius: 22px; }
    }

    /* ============ brands ============ */
    .brands {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }
    .brand {
        border: 1px solid var(--border);
        padding: 14px;
    }
    .brand-logo {
        height: 40px;
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }
    .brand-logo img {
        height: 40px;
        width: 40px;
        border-radius: 9px;
        object-fit: cover;
    }
    .brand-logo img.wordmark {
        width: auto;
        border-radius: 0;
        object-fit: contain;
    }
    .brand-slot {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border: 1px dashed var(--border);
        border-radius: 9px;
        font-family: var(--font-mono);
        font-size: 20px;
        color: var(--muted);
    }
    .brand-slot.nda { font-size: 11px; letter-spacing: 0.05em; }
    .brand-mark {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 18px;
    }
    .brand-dates {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 2px;
    }
    .brand-open { border-style: dashed; }

    /* ============ contact ============ */
    .email-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 14px;
        flex-wrap: wrap;
    }
    .email {
        font-family: var(--font-mono);
        font-size: 17px;
        padding: 7px 12px;
        border: 1px solid var(--border);
        user-select: all;
    }

    @media (max-width: 720px) {
        .ugc-headline { font-size: 19px; }
        .ugc-headline .big { font-size: 48px; }
        .stat b { font-size: 22px; }
        .brands { grid-template-columns: 1fr 1fr; }
    }
</style>
