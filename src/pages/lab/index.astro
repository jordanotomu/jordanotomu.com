---
// index of the unlisted design variants
import LabLayout from "~/lab/LabLayout.astro";
import PixelIcon from "~/lab/PixelIcon.astro";


const variants = [
    { href: "/lab/desktop", icon: "folder", name: "1 · Desktop", blurb: "a win95 desktop: icons, draggable windows, taskbar, start menu." },
    { href: "/", icon: "folder-open", name: "2 · Explorer (live homepage)", blurb: "one win98 explorer window: folders, details view, web-view sidebar." },
    { href: "/lab/setup", icon: "star", name: "3 · Setup Wizard", blurb: "bios boot, then an installshield wizard that walks through the portfolio." },
] as const;
---

<LabLayout title="Lab — design variants">
    <div class="bg">
        <div class="window picker">
            <div class="title-bar"><div class="title-bar-text">Display Properties — choose a theme</div></div>
            <div class="window-body">
                <p>pick a variant to preview. unlisted design experiments.</p>
                <ul>
                    {variants.map((v) => (
                        <li><a href={v.href}><PixelIcon name={v.icon} size={32} /><span><b>{v.name}</b><br />{v.blurb}</span></a></li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</LabLayout>

<style>
    .bg { min-height: 100vh; background: #008080; display: grid; place-items: center; padding: 16px; font-size: 11px; }
    .picker { width: min(460px, 100%); }
    ul { list-style: none; margin: 8px 0 0; padding: 0; }
    a { display: flex; gap: 12px; align-items: center; padding: 8px; color: #000; text-decoration: none; line-height: 1.5; }
    a:hover, a:focus { background: #000080; color: #fff; }
</style>
