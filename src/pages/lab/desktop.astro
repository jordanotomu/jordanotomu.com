---
// lab variant 1 — the whole site is a win95 desktop: icons, draggable
// windows, a taskbar with a start menu and clock. unlisted (noindex).
import LabLayout from "~/lab/LabLayout.astro";
import PixelIcon from "~/lab/PixelIcon.astro";
import { links, bio, motto, ugc, onRepeat, loadContent, logoSrc } from "~/lab/data";


const { experience, education, projects } = await loadContent();

const icons = [
    { id: "about", label: "About Me.txt", icon: "doc" },
    { id: "experience", label: "Experience", icon: "folder" },
    { id: "projects", label: "Projects", icon: "folder" },
    { id: "ugc", label: "UGC.exe", icon: "film" },
    { id: "education", label: "Education", icon: "folder" },
    { id: "music", label: "Music", icon: "cd" },
    { id: "internet", label: "Internet", icon: "globe" },
    { id: "resume", label: "Resume.pdf", icon: "pdf", href: links.resume },
    { id: "contact", label: "Contact", icon: "mail" },
    { id: "trash", label: "Recycle Bin", icon: "trash" },
] as const;
---

<LabLayout title="Jordan Otomu — Desktop">
    <div class="desktop" id="desktop">
        <ul class="icons">
            {icons.map((i) => (
                <li>
                    {"href" in i ? (
                        <a class="dicon" href={i.href} target="_blank" rel="noopener">
                            <PixelIcon name={i.icon} />
                            <span>{i.label}</span>
                        </a>
                    ) : (
                        <button class="dicon" type="button" data-open={i.id}>
                            <PixelIcon name={i.icon} />
                            <span>{i.label}</span>
                        </button>
                    )}
                </li>
            ))}
        </ul>

        <!-- ============ windows ============ -->
        <section class="window win" id="w-about" data-title="About Me.txt - Notepad" data-icon="doc" style="--x: 230px; --y: 40px; --w: 620px;">
            <div class="title-bar">
                <div class="title-bar-text">About Me.txt - Notepad</div>
                <div class="title-bar-controls"><button aria-label="Minimize"></button><button aria-label="Maximize"></button><button aria-label="Close"></button></div>
            </div>
            <div class="window-body">
                <div class="about">
                    <div class="about-photo">
                        <img src="/assets/photos/jordan-yosemite.jpg" alt="Jordan looking out over a river and pine forest" />
                    </div>
                    <div class="about-text">
                        <h1>Jordan Otomu</h1>
                        {bio.map((p) => <p>{p}</p>)}
                        <p class="motto">"{motto.text}" — {motto.by}</p>
                        <div class="btn-row">
                            <button data-open="experience">Experience</button>
                            <button data-open="projects">Projects</button>
                            <button data-open="ugc">UGC</button>
                            <a class="linkbtn" href={links.resume} target="_blank" rel="noopener"><button tabindex="-1">Resume…</button></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="status-bar"><p class="status-bar-field">Ln 1, Col 1</p><p class="status-bar-field">houston, tx → nyc</p></div>
        </section>

        <section class="window win" id="w-experience" data-title="Experience" data-icon="folder" hidden style="--x: 220px; --y: 70px; --w: 640px;">
            <div class="title-bar">
                <div class="title-bar-text">C:\Jordan\Experience</div>
                <div class="title-bar-controls"><button aria-label="Minimize"></button><button aria-label="Maximize"></button><button aria-label="Close"></button></div>
            </div>
            <div class="window-body">
                {experience.map(({ data, Content }) => (
                    <fieldset class="entry">
                        <legend>{data.company}</legend>
                        <div class="entry-head">
                            {logoSrc[data.logo] ? <img class="logo" src={logoSrc[data.logo]} alt="" /> : <span class="logo logo-text">{data.logo}</span>}
                            <div>
                                <b>{data.role}</b>
                                <div class="muted">{data.place} · {data.dates}</div>
                            </div>
                        </div>
                        <div class="md"><Content /></div>
                    </fieldset>
                ))}
            </div>
            <div class="status-bar"><p class="status-bar-field">{experience.length} object(s)</p></div>
        </section>

        <section class="window win" id="w-projects" data-title="Projects" data-icon="folder" hidden style="--x: 260px; --y: 90px; --w: 640px;">
            <div class="title-bar">
                <div class="title-bar-text">C:\Jordan\Projects</div>
                <div class="title-bar-controls"><button aria-label="Minimize"></button><button aria-label="Maximize"></button><button aria-label="Close"></button></div>
            </div>
            <div class="window-body">
                <p class="muted">things i've built, shipped, or sold.</p>
                {projects.map(({ data, Content }) => (
                    <fieldset class="entry">
                        <legend>{data.title}{data.tag && <span class="tag"> — {data.tag}</span>}</legend>
                        <div class="md"><Content /></div>
                        {data.metrics.length > 0 && (
                            <div class="metrics">
                                {data.metrics.map((m: { value: string; label: string }) => (
                                    <div class="sunken"><b>{m.value}</b><span>{m.label}</span></div>
                                ))}
                            </div>
                        )}
                        {data.stack.length > 0 && <div class="muted small">{data.stack.join(" · ")}</div>}
                    </fieldset>
                ))}
            </div>
        </section>

        <section class="window win" id="w-ugc" data-title="UGC.exe" data-icon="film" hidden style="--x: 300px; --y: 40px; --w: 680px;">
            <div class="title-bar">
                <div class="title-bar-text">UGC.exe</div>
                <div class="title-bar-controls"><button aria-label="Minimize"></button><button aria-label="Maximize"></button><button aria-label="Close"></button></div>
            </div>
            <div class="window-body">
                <div class="ugc-hero">
                    <div class="big">$30K/mo</div>
                    <div>ugc creator. {ugc.sub}</div>
                </div>
                <div class="metrics">
                    {ugc.stats.map((s) => <div class="sunken"><b>{s.value}</b><span>{s.label}</span></div>)}
                </div>
                {ugc.results.map((r) => (
                    <figure class="shot"><img src={r.src} alt="" loading="lazy" /><figcaption>{r.caption}</figcaption></figure>
                ))}
                <fieldset>
                    <legend>Brands</legend>
                    <div class="brands">
                        {ugc.brands.map((b) => (
                            <div class="brand sunken"><img class:list={[{ wordmark: b.wordmark }]} src={b.logo} alt="" /><b>{b.name}</b><span class="muted small">{b.dates}</span></div>
                        ))}
                    </div>
                </fieldset>
                <fieldset>
                    <legend>Tools</legend>
                    <p>{ugc.tool.blurb}</p>
                    <a href={ugc.tool.url} target="_blank" rel="noopener">{ugc.tool.name} →</a>
                </fieldset>
            </div>
        </section>

        <section class="window win" id="w-education" data-title="Education" data-icon="folder" hidden style="--x: 200px; --y: 120px; --w: 600px;">
            <div class="title-bar">
                <div class="title-bar-text">C:\Jordan\Education</div>
                <div class="title-bar-controls"><button aria-label="Minimize"></button><button aria-label="Maximize"></button><button aria-label="Close"></button></div>
            </div>
            <div class="window-body">
                {education.map(({ data, Content }) => (
                    <fieldset class="entry">
                        <legend>{data.school}</legend>
                        <div class="entry-head">
                            {logoSrc[data.logo] && <img class="logo" src={logoSrc[data.logo]} alt="" />}
                            <div><b>{data.degree}</b><div class="muted">{data.place} · {data.dates}</div></div>
                        </div>
                        <div class="md"><Content /></div>
                    </fieldset>
                ))}
            </div>
        </section>

        <section class="window win" id="w-music" data-title="CD Player" data-icon="cd" hidden style="--x: 420px; --y: 160px; --w: 420px;">
            <div class="title-bar">
                <div class="title-bar-text">CD Player — on repeat</div>
                <div class="title-bar-controls"><button aria-label="Minimize"></button><button aria-label="Maximize"></button><button aria-label="Close"></button></div>
            </div>
            <div class="window-body">
                <div class="lcd">[01] 00:00 &nbsp;now playing: jordan's rotation</div>
                <ul class="tracks">
                    {onRepeat.map((t, i) => (
                        <li><a href={t.url} target="_blank" rel="noopener"><img src={t.art} alt="" loading="lazy" /><span><b>{String(i + 1).padStart(2, "0")}. {t.name}</b><span class="muted">{t.artist}</span></span></a></li>
                    ))}
                </ul>
                <a href="/random/music">full music page →</a>
            </div>
        </section>

        <section class="window win" id="w-internet" data-title="Internet Explorer" data-icon="globe" hidden style="--x: 360px; --y: 110px; --w: 420px;">
            <div class="title-bar">
                <div class="title-bar-text">Favorites - Internet Explorer</div>
                <div class="title-bar-controls"><button aria-label="Minimize"></button><button aria-label="Maximize"></button><button aria-label="Close"></button></div>
            </div>
            <div class="window-body">
                <ul class="tree-view">
                    <li>📁 Favorites
                        <ul>
                            <li><a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
                            <li><a href={links.github} target="_blank" rel="noopener">GitHub</a></li>
                            <li><a href={links.x} target="_blank" rel="noopener">X</a></li>
                            <li><a href={links.instagram} target="_blank" rel="noopener">Instagram</a></li>
                            <li><a href={links.spotify} target="_blank" rel="noopener">Spotify</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </section>

        <section class="window win" id="w-contact" data-title="Contact" data-icon="mail" hidden style="--x: 480px; --y: 200px; --w: 380px;">
            <div class="title-bar">
                <div class="title-bar-text">New Message</div>
                <div class="title-bar-controls"><button aria-label="Close"></button></div>
            </div>
            <div class="window-body">
                <div class="field-row-stacked"><label>To:</label><input type="text" readonly value={links.email} /></div>
                <div class="field-row-stacked"><label>UGC / brand deals:</label><input type="text" readonly value={links.ugcEmail} /></div>
                <p class="muted small">select the address and copy it — or say hi on <a href={links.linkedin} target="_blank" rel="noopener">linkedin</a>.</p>
            </div>
        </section>

        <section class="window win" id="w-trash" data-title="Recycle Bin" data-icon="trash" hidden style="--x: 520px; --y: 260px; --w: 340px;">
            <div class="title-bar">
                <div class="title-bar-text">Recycle Bin</div>
                <div class="title-bar-controls"><button aria-label="Close"></button></div>
            </div>
            <div class="window-body">
                <p>this folder is empty.</p>
                <p class="muted small">i don't throw things away. i refactor them.</p>
            </div>
            <div class="status-bar"><p class="status-bar-field">0 object(s)</p></div>
        </section>

        <!-- ============ start menu + taskbar ============ -->
        <div class="window start-menu" id="start-menu" hidden>
            <div class="start-side"><span>Jordan<b>98</b></span></div>
            <ul>
                <li><button data-open="about"><PixelIcon name="doc" size={24} />About Me</button></li>
                <li><button data-open="experience"><PixelIcon name="folder" size={24} />Experience</button></li>
                <li><button data-open="projects"><PixelIcon name="folder" size={24} />Projects</button></li>
                <li><button data-open="ugc"><PixelIcon name="film" size={24} />UGC</button></li>
                <li><button data-open="music"><PixelIcon name="cd" size={24} />Music</button></li>
                <li><a href={links.resume} target="_blank" rel="noopener"><PixelIcon name="pdf" size={24} />Resume</a></li>
                <li class="sep"></li>
                <li><a href="/"><PixelIcon name="pc" size={24} />Classic site</a></li>
                <li><button id="shutdown"><PixelIcon name="star" size={24} />Shut Down…</button></li>
            </ul>
        </div>

        <nav class="taskbar" aria-label="taskbar">
            <button class="start" id="start-btn" aria-expanded="false"><img src="/favicon-32.png" alt="" width="16" height="16" /> <b>Start</b></button>
            <div class="tasks" id="tasks"></div>
            <div class="tray"><span id="clock"></span></div>
        </nav>

        <div class="shutdown" id="shutdown-screen" hidden>
            <p>It's now safe to turn off<br />your computer.</p>
            <button id="wake">(click to turn it back on)</button>
        </div>
    </div>
</LabLayout>

<style>
    .desktop {
        position: fixed;
        inset: 0;
        background: #008080;
        overflow: hidden;
        font-size: 11px;
    }
    .icons {
        list-style: none;
        margin: 0;
        padding: 10px 6px;
        display: grid;
        grid-auto-flow: column;
        grid-template-rows: repeat(auto-fill, 84px);
        height: calc(100% - 36px);
        width: max-content;
        gap: 4px;
    }
    .dicon {
        all: unset;
        box-sizing: border-box;
        width: 84px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 4px;
        cursor: pointer;
        color: #fff;
        text-align: center;
        font-size: 11px;
        text-decoration: none;
    }
    .dicon span { padding: 1px 2px; line-height: 1.2; }
    .dicon:focus span, .dicon:hover span { background: #000080; outline: 1px dotted #fff; }
    .dicon:focus .px-icon { filter: brightness(0.7) sepia(1) hue-rotate(190deg) saturate(4); }

    .win {
        position: absolute;
        left: var(--x);
        top: var(--y);
        width: min(var(--w), calc(100vw - 16px));
        max-height: calc(100vh - 60px);
        display: flex;
        flex-direction: column;
    }
    .win[hidden] { display: none; }
    .win.max { left: 0 !important; top: 0 !important; width: 100vw; height: calc(100vh - 32px); max-height: none; }
    .win .title-bar { cursor: move; touch-action: none; user-select: none; }
    .win:not(.active) .title-bar { background: linear-gradient(90deg, #808080, #b5b5b5); }
    .win .window-body { overflow: auto; flex: 1; margin: 6px; }
    .win .window-body p { font-size: 11px; line-height: 1.5; margin: 0 0 8px; }

    .about { display: grid; grid-template-columns: 180px 1fr; gap: 14px; }
    .about-photo img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border: 2px inset #fff; }
    .about h1 { font-size: 20px; margin: 0 0 8px; }
    .motto { font-style: italic; }
    .btn-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .linkbtn { text-decoration: none; }

    .entry { margin-bottom: 10px; }
    .entry legend { font-weight: bold; }
    .entry .tag { font-weight: normal; color: #555; }
    .entry-head { display: flex; gap: 10px; align-items: center; margin-bottom: 6px; }
    .logo { width: 36px; height: 36px; object-fit: contain; background: #fff; border: 2px inset #fff; }
    .logo-text { display: grid; place-items: center; font-weight: bold; text-transform: uppercase; font-size: 9px; }
    .md :global(ul) { margin: 4px 0 0; padding-left: 18px; }
    .md :global(li), .md :global(p) { font-size: 11px; line-height: 1.5; margin: 0 0 4px; }
    .muted { color: #444; }
    .small { font-size: 11px; }

    .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 6px; margin: 8px 0; }
    .sunken { background: #fff; box-shadow: inset -1px -1px #fff, inset 1px 1px #808080, inset -2px -2px #dfdfdf, inset 2px 2px #0a0a0a; padding: 6px 8px; display: flex; flex-direction: column; }
    .sunken b { font-size: 16px; }
    .sunken span { font-size: 10px; color: #444; text-transform: uppercase; }

    .ugc-hero { background: #000080; color: #fff; padding: 12px; margin-bottom: 8px; }
    .ugc-hero .big { font-size: 34px; font-weight: bold; font-style: italic; }
    .shot { margin: 0 0 10px; }
    .shot img { display: block; border: 2px inset #fff; }
    .shot figcaption { font-size: 11px; margin-top: 3px; }
    .brands { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .brand { align-items: flex-start; gap: 2px; }
    .brand img { height: 28px; width: 28px; object-fit: cover; }
    .brand img.wordmark { width: auto; object-fit: contain; }

    .lcd { background: #000; color: #0f0; font-family: monospace; padding: 6px 8px; margin-bottom: 8px; }
    .tracks { list-style: none; margin: 0 0 8px; padding: 0; }
    .tracks a { display: flex; gap: 8px; align-items: center; padding: 3px; color: #000; text-decoration: none; }
    .tracks a:hover { background: #000080; color: #fff; }
    .tracks a:hover .muted { color: #ccc; }
    .tracks img { width: 32px; height: 32px; }
    .tracks span { display: flex; flex-direction: column; }

    .taskbar {
        position: absolute;
        left: 0; right: 0; bottom: 0;
        height: 32px;
        background: #c0c0c0;
        box-shadow: inset 0 1px #fff, inset 0 2px #dfdfdf;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 2px 3px 0;
        z-index: 9000;
    }
    .start { display: flex; align-items: center; gap: 4px; min-width: 0; padding: 0 6px; height: 24px; }
    .start[aria-expanded="true"] { box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a, inset -2px -2px #dfdfdf, inset 2px 2px #808080; }
    .tasks { flex: 1; display: flex; gap: 3px; overflow: hidden; }
    .tasks button { min-width: 0; max-width: 160px; flex: 1 1 0; height: 24px; text-align: left; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .tasks button.on { box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a, inset -2px -2px #dfdfdf, inset 2px 2px #808080; background: repeating-conic-gradient(#c0c0c0 0% 25%, #fff 0% 50%) 0 0 / 2px 2px; font-weight: bold; }
    .tray { height: 24px; padding: 0 10px; display: flex; align-items: center; box-shadow: inset -1px -1px #fff, inset 1px 1px #808080; }

    .start-menu { position: absolute; left: 2px; bottom: 32px; display: flex; z-index: 9001; width: 220px; }
    .start-menu[hidden] { display: none; }
    .start-side { background: linear-gradient(0deg, #000080, #1084d0); width: 26px; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 8px; }
    .start-side span { writing-mode: vertical-rl; transform: rotate(180deg); color: #c0c0c0; font-size: 16px; font-weight: bold; letter-spacing: 1px; }
    .start-side b { color: #fff; }
    .start-menu ul { list-style: none; margin: 0; padding: 2px; flex: 1; }
    .start-menu li > button, .start-menu li > a {
        all: unset; box-sizing: border-box; display: flex; align-items: center; gap: 10px;
        width: 100%; padding: 4px 6px; cursor: pointer; color: #000; font-size: 11px;
    }
    .start-menu li > button:hover, .start-menu li > a:hover, .start-menu li > button:focus, .start-menu li > a:focus { background: #000080; color: #fff; }
    .start-menu .sep { border-top: 1px solid #808080; border-bottom: 1px solid #fff; margin: 3px 2px; }

    .shutdown { position: fixed; inset: 0; background: #000; color: #ff8000; z-index: 9999; display: grid; place-content: center; text-align: center; font-size: 28px; }
    .shutdown[hidden] { display: none; }
    .shutdown button { margin-top: 30px; background: none; box-shadow: none; color: #666; font-size: 12px; }

    @media (max-width: 720px) {
        .icons { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); grid-template-rows: none; width: 100%; height: auto; }
        .dicon { width: 100%; }
        .win, .win.max { left: 6px !important; top: 6px !important; width: calc(100vw - 12px); height: calc(100% - 50px); max-height: none; }
        .about { grid-template-columns: 1fr; }
        .about-photo img { aspect-ratio: 4 / 3; }
        .brands { grid-template-columns: 1fr 1fr; }
        .tasks button { max-width: 110px; }
    }
</style>

<script>
    const wins = [...document.querySelectorAll<HTMLElement>(".win")];
    const tasks = document.getElementById("tasks")!;
    const startBtn = document.getElementById("start-btn")!;
    const startMenu = document.getElementById("start-menu")!;
    let z = 10;

    function focusWin(w: HTMLElement) {
        wins.forEach((x) => x.classList.remove("active"));
        w.classList.add("active");
        w.style.zIndex = String(++z);
        renderTasks();
    }
    function openWin(id: string) {
        const w = document.getElementById("w-" + id);
        if (!w) return;
        w.hidden = false;
        w.dataset.open = "1";
        focusWin(w);
        closeStart();
    }
    function closeWin(w: HTMLElement) {
        w.hidden = true;
        delete w.dataset.open;
        w.classList.remove("max", "active");
        renderTasks();
    }
    function renderTasks() {
        tasks.innerHTML = "";
        wins.filter((w) => w.dataset.open).forEach((w) => {
            const b = document.createElement("button");
            b.textContent = w.dataset.title ?? "";
            if (!w.hidden && w.classList.contains("active")) b.classList.add("on");
            b.onclick = () => {
                if (!w.hidden && w.classList.contains("active")) { w.hidden = true; w.classList.remove("active"); renderTasks(); }
                else { w.hidden = false; focusWin(w); }
            };
            tasks.appendChild(b);
        });
    }

    document.querySelectorAll<HTMLElement>("[data-open]").forEach((el) =>
        el.addEventListener("click", () => openWin(el.dataset.open!))
    );
    // desktop icons open on double-click on desktop, single tap on touch
    wins.forEach((w) => {
        w.addEventListener("pointerdown", () => focusWin(w));
        const [min, max, close] = ["Minimize", "Maximize", "Close"].map((l) =>
            w.querySelector<HTMLButtonElement>(`button[aria-label="${l}"]`)
        );
        close?.addEventListener("click", (e) => { e.stopPropagation(); closeWin(w); });
        min?.addEventListener("click", (e) => { e.stopPropagation(); w.hidden = true; w.classList.remove("active"); renderTasks(); });
        max?.addEventListener("click", (e) => { e.stopPropagation(); w.classList.toggle("max"); });

        const bar = w.querySelector<HTMLElement>(".title-bar")!;
        bar.addEventListener("dblclick", () => w.classList.toggle("max"));
        bar.addEventListener("pointerdown", (e) => {
            if ((e.target as HTMLElement).closest("button") || matchMedia("(max-width: 720px)").matches || w.classList.contains("max")) return;
            const sx = e.clientX - w.offsetLeft, sy = e.clientY - w.offsetTop;
            bar.setPointerCapture(e.pointerId);
            const move = (ev: PointerEvent) => {
                w.style.left = Math.max(-w.offsetWidth + 80, Math.min(innerWidth - 80, ev.clientX - sx)) + "px";
                w.style.top = Math.max(0, Math.min(innerHeight - 60, ev.clientY - sy)) + "px";
            };
            const up = () => { bar.removeEventListener("pointermove", move); bar.removeEventListener("pointerup", up); };
            bar.addEventListener("pointermove", move);
            bar.addEventListener("pointerup", up);
        });
    });

    function closeStart() { startMenu.hidden = true; startBtn.setAttribute("aria-expanded", "false"); }
    startBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = startMenu.hidden;
        startMenu.hidden = !open;
        startBtn.setAttribute("aria-expanded", String(open));
    });
    document.addEventListener("click", (e) => { if (!startMenu.contains(e.target as Node)) closeStart(); });

    const screen = document.getElementById("shutdown-screen")!;
    document.getElementById("shutdown")!.addEventListener("click", () => { closeStart(); screen.hidden = false; });
    document.getElementById("wake")!.addEventListener("click", () => (screen.hidden = true));

    const clock = document.getElementById("clock")!;
    const tick = () => (clock.textContent = new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit" }));
    tick();
    setInterval(tick, 30_000);

    openWin("about");
</script>
