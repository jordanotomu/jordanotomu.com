---
// homepage: the site as one win98 explorer window. sections are folders,
// experience/projects are file lists in details view, and the classic
// "web view" sidebar shows whatever row is selected.
import LabLayout from "~/lab/LabLayout.astro";
import PixelIcon from "~/lab/PixelIcon.astro";
import { links, bio, motto, ugc, onRepeat, albumWall, loadContent, logoSrc } from "~/lab/data";


const { experience, education, projects } = await loadContent();

const folders = [
    { id: "about", label: "About Me", icon: "doc", blurb: "who i am, in three paragraphs." },
    { id: "experience", label: "Experience", icon: "folder", blurb: "select a file to see what i did there." },
    { id: "projects", label: "Projects", icon: "folder", blurb: "things i've built, shipped, or sold." },
    { id: "ugc", label: "UGC", icon: "film", blurb: "the other job: ugc for consumer apps." },
    { id: "education", label: "Education", icon: "folder", blurb: "uh in two years, early college before that." },
    { id: "music", label: "Music", icon: "cd", blurb: "what's on repeat right now." },
] as const;
---

<LabLayout title="Jordan Otomu" indexable description="Jordan Otomu — CS @ University of Houston, incoming Software Engineer at Snapchat in NYC, and UGC creator. A Windows 98-style portfolio.">
    <div class="bg">
        <div class="window explorer">
            <div class="title-bar">
                <div class="title-bar-text"><span id="title-text">C:\Jordan Otomu</span></div>
                <div class="title-bar-controls"><button aria-label="Minimize"></button><button aria-label="Maximize"></button><button aria-label="Close" onclick="location.href='/classic'"></button></div>
            </div>

            <div class="menubar">
                <span><u>F</u>ile</span><span><u>E</u>dit</span><span><u>V</u>iew</span><span><u>G</u>o</span>
                <details class="menu">
                    <summary>F<u>a</u>vorites</summary>
                    <div class="window menu-pop">
                        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
                        <a href={links.github} target="_blank" rel="noopener">GitHub</a>
                        <a href={links.x} target="_blank" rel="noopener">X</a>
                        <a href={links.instagram} target="_blank" rel="noopener">Instagram</a>
                        <a href={links.spotify} target="_blank" rel="noopener">Spotify</a>
                        <hr />
                        <a href="/classic">Classic site</a>
                    </div>
                </details>
                <span><u>H</u>elp</span>
            </div>

            <div class="toolbar">
                <button class="tool" id="back" disabled><span class="tri"><PixelIcon name="back" size={16} /></span>Back</button>
                <button class="tool" id="up" disabled><span class="tri"><PixelIcon name="up" size={16} /></span>Up</button>
                <span class="tsep"></span>
                <a class="tool" href={links.resume} target="_blank" rel="noopener"><PixelIcon name="pdf" size={22} />Resume</a>
                <a class="tool" href={"mailto:" + links.email}><PixelIcon name="mail" size={22} />Mail</a>
                <a class="tool" href={links.linkedin} target="_blank" rel="noopener"><PixelIcon name="globe" size={22} />LinkedIn</a>
            </div>

            <div class="address">
                <label for="addr">Address</label>
                <div class="addr-field"><PixelIcon name="folder-open" size={16} /><input id="addr" type="text" readonly value="C:\Jordan Otomu" /></div>
            </div>

            <div class="pane">
                <!-- ============ web view sidebar ============ -->
                <aside class="webview">
                    <PixelIcon name="pc" size={48} />
                    <h2 id="side-title">Jordan Otomu</h2>
                    <div class="rule"></div>
                    <div id="side-default">
                        <p>cs @ university of houston. incoming software engineer at <b>snapchat</b> in nyc. <b>ugc creator</b> on the side.</p>
                        <p class="muted">select an item to view its description.</p>
                    </div>
                    {folders.map((f) => <p class="side-blurb" data-side={f.id} hidden>{f.blurb}</p>)}

                    {experience.map(({ data, Content }, i) => (
                        <div class="detail" data-detail={`experience-${i}`} hidden>
                            {logoSrc[data.logo] && <img class="logo" src={logoSrc[data.logo]} alt="" />}
                            <b>{data.company}</b>
                            <div class="muted">{data.role}</div>
                            <div class="muted">{data.place} · {data.dates}</div>
                            <div class="md"><Content /></div>
                        </div>
                    ))}
                    {projects.map(({ data, Content }, i) => (
                        <div class="detail" data-detail={`projects-${i}`} hidden>
                            <b>{data.title}</b>
                            {data.tag && <div class="muted">{data.tag}</div>}
                            <div class="md"><Content /></div>
                            {data.metrics.map((m: { value: string; label: string }) => <div class="kv"><span>{m.label}</span><b>{m.value}</b></div>)}
                            <div class="muted small">{data.stack.join(" · ")}</div>
                        </div>
                    ))}
                    {education.map(({ data, Content }, i) => (
                        <div class="detail" data-detail={`education-${i}`} hidden>
                            {logoSrc[data.logo] && <img class="logo" src={logoSrc[data.logo]} alt="" />}
                            <b>{data.school}</b>
                            <div class="muted">{data.degree}</div>
                            <div class="md"><Content /></div>
                        </div>
                    ))}
                </aside>

                <!-- ============ views ============ -->
                <main class="main sunken-panel">
                    <section data-view="root">
                        <ul class="bigicons">
                            {folders.map((f) => (
                                <li><button class="bigicon" data-go={f.id}><PixelIcon name={f.icon} size={40} /><span>{f.label}</span></button></li>
                            ))}
                            <li><a class="bigicon" href={links.resume} target="_blank" rel="noopener"><PixelIcon name="pdf" size={40} /><span>Resume.pdf</span></a></li>
                            <li><a class="bigicon" href={"mailto:" + links.email}><PixelIcon name="mail" size={40} /><span>Contact</span></a></li>
                        </ul>
                    </section>

                    <section data-view="about" hidden>
                        <div class="notepad">
                            <img src="/assets/photos/jordan-yosemite.jpg" alt="Jordan looking out over a river and pine forest" />
                            <div>
                                {bio.map((p) => <p>{p}</p>)}
                                <p><i>"{motto.text}"</i> — {motto.by}</p>
                                <p>reach out: <a href={links.linkedin} target="_blank" rel="noopener">linkedin</a> · {links.email}</p>
                            </div>
                        </div>
                    </section>

                    <section data-view="experience" hidden>
                        <table class="details">
                            <thead><tr><th>Name</th><th>Role</th><th class="hide-sm">Location</th><th>Dates</th></tr></thead>
                            <tbody>
                                {experience.map(({ data }, i) => (
                                    <tr data-row={`experience-${i}`} tabindex="0"><td><PixelIcon name="doc" size={16} />{data.company}</td><td>{data.role}</td><td class="hide-sm">{data.place}</td><td>{data.dates}</td></tr>
                                ))}
                            </tbody>
                        </table>
                    </section>

                    <section data-view="projects" hidden>
                        <table class="details">
                            <thead><tr><th>Name</th><th>Type</th><th>Highlights</th></tr></thead>
                            <tbody>
                                {projects.map(({ data }, i) => (
                                    <tr data-row={`projects-${i}`} tabindex="0"><td><PixelIcon name={data.tier === "sandbox" ? "doc" : "star"} size={16} />{data.title}</td><td>{data.tag ?? ""}</td><td>{data.metrics.map((m: { value: string }) => m.value).join(" · ")}</td></tr>
                                ))}
                            </tbody>
                        </table>
                    </section>

                    <section data-view="education" hidden>
                        <table class="details">
                            <thead><tr><th>Name</th><th>Degree</th><th>Dates</th></tr></thead>
                            <tbody>
                                {education.map(({ data }, i) => (
                                    <tr data-row={`education-${i}`} tabindex="0"><td><PixelIcon name="doc" size={16} />{data.school}</td><td>{data.degree}</td><td>{data.dates}</td></tr>
                                ))}
                            </tbody>
                        </table>
                    </section>

                    <section data-view="ugc" hidden class="ugc">
                        <div class="ugc-banner"><b>$30K/mo</b> ugc creator · {ugc.sub}</div>
                        <div class="stats">
                            {ugc.stats.map((s) => <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>)}
                        </div>
                        <div class="shots">
                            {ugc.results.map((r) => <figure><img src={r.src} alt="" loading="lazy" /><figcaption>{r.caption}</figcaption></figure>)}
                        </div>
                        <fieldset>
                            <legend>Brands</legend>
                            <div class="brands">
                                {ugc.brands.map((b) => <div class="brand"><img class:list={[{ wordmark: b.wordmark }]} src={b.logo} alt="" /><span><b>{b.name}</b><br /><span class="muted">{b.dates}</span></span></div>)}
                            </div>
                        </fieldset>
                        <p>{ugc.tool.blurb} <a href={ugc.tool.url} target="_blank" rel="noopener">fakechat →</a></p>
                        <p>brand deals: <b>{links.ugcEmail}</b></p>
                    </section>

                    <section data-view="music" hidden class="music">
                        <!-- media player: live from /api/now-playing, falls back to the top on-repeat track -->
                        <div class="window player" id="player" data-state="loading">
                            <div class="title-bar"><div class="title-bar-text">Media Player</div></div>
                            <div class="window-body">
                                <div class="screen">
                                    <img id="np-art" src={onRepeat[0].art} alt="" />
                                    <div class="np-text">
                                        <span class="np-label" id="np-label">checking spotify…</span>
                                        <a id="np-title" href={onRepeat[0].url} target="_blank" rel="noopener">{onRepeat[0].name}</a>
                                        <span id="np-artist">{onRepeat[0].artist}</span>
                                        <span class="np-album" id="np-album">{onRepeat[0].album}</span>
                                    </div>
                                    <div class="eq" aria-hidden="true">{Array.from({ length: 12 }, () => <i></i>)}</div>
                                </div>
                                <div class="seek"><span id="np-bar"></span></div>
                                <div class="controls">
                                    <button aria-label="previous" disabled>|◀&#xFE0E;</button>
                                    <button aria-label="play" id="np-play">▶&#xFE0E;</button>
                                    <button aria-label="next" disabled>▶&#xFE0E;|</button>
                                    <a href={links.spotify} target="_blank" rel="noopener">open spotify profile →</a>
                                </div>
                            </div>
                        </div>

                        <h4 class="group">On Repeat</h4>
                        <table class="details">
                            <thead><tr><th>#</th><th>Title</th><th>Artist</th><th class="hide-sm">Album</th></tr></thead>
                            <tbody>
                                {onRepeat.map((t, i) => (
                                    <tr><td>{i + 1}</td><td><a href={t.url} target="_blank" rel="noopener"><img class="art" src={t.art} alt="" loading="lazy" />{t.name}</a></td><td>{t.artist}</td><td class="hide-sm">{t.album}</td></tr>
                                ))}
                            </tbody>
                        </table>

                        <h4 class="group">Album Wall <span class="muted">— {albumWall.length} records in rotation</span></h4>
                        <ul class="thumbs">
                            {albumWall.map((a) => (
                                <li title={`${a.artist} — ${a.album}`}>
                                    <div class="thumb"><img src={a.art} alt={`${a.album} by ${a.artist}`} loading="lazy" /></div>
                                    <span>{a.album}</span>
                                </li>
                            ))}
                        </ul>
                    </section>
                </main>
            </div>

            <div class="status-bar">
                <p class="status-bar-field" id="status-count">8 object(s)</p>
                <p class="status-bar-field" id="status-sel"></p>
                <p class="status-bar-field"><PixelIcon name="pc" size={14} /> My Computer</p>
            </div>
        </div>
    </div>
</LabLayout>

<style>
    .bg { min-height: 100vh; background: #008080; padding: 24px; font-size: 11px; }
    .explorer { max-width: 1040px; margin: 0 auto; height: calc(100vh - 48px); display: flex; flex-direction: column; }
    /* reading text: WIN95FA (a win95 system-font revival) at its native 16px,
       so it stays pixel-crisp but readable; 98.css's 11px font stays on the chrome */
    .webview, .main, .main :global(input) {
        font-family: "WIN95FA", "Pixelated MS Sans Serif", Tahoma, sans-serif;
        font-size: 16px;
        line-height: 1.3;
        color: #1a1a1a;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    .webview :global(*), .main :global(*) { font-family: inherit; -webkit-font-smoothing: inherit; }
    .details td, .details th { font-size: 16px; }
    .menubar { display: flex; gap: 2px; padding: 2px 4px; border-bottom: 1px solid #808080; box-shadow: 0 1px #fff; }
    .menubar > span, .menubar summary { padding: 2px 6px; cursor: default; list-style: none; }
    .menubar summary::-webkit-details-marker { display: none; }
    .menubar > span:hover, .menubar summary:hover, .menu[open] summary { background: #000080; color: #fff; }
    .menu { position: relative; }
    .menu-pop { position: absolute; top: 100%; left: 0; z-index: 20; min-width: 150px; padding: 2px; display: flex; flex-direction: column; }
    .menu-pop a { color: #000; text-decoration: none; padding: 4px 18px; }
    .menu-pop a:hover { background: #000080; color: #fff; }
    .menu-pop hr { width: 100%; }

    .toolbar { display: flex; align-items: center; gap: 2px; padding: 3px 4px; border-bottom: 1px solid #808080; box-shadow: 0 1px #fff; }
    .tool {
        all: unset; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; gap: 2px;
        min-width: 56px; padding: 3px 6px; cursor: pointer; color: #000; font-size: 11px; text-decoration: none;
    }
    .tool:hover:not(:disabled) { box-shadow: inset -1px -1px #808080, inset 1px 1px #fff; }
    .tool:active:not(:disabled) { box-shadow: inset 1px 1px #808080, inset -1px -1px #fff; }
    .tool:disabled { color: #808080; text-shadow: 1px 1px #fff; cursor: default; }
    .tool:disabled :global(.px-icon) { opacity: 0.35; }
    /* the arrows draw at an exact 1:1 pixel scale; pad them to the 22px row the other toolbar icons use */
    .tri { width: 22px; height: 22px; display: grid; place-items: center; }
    .tsep { width: 2px; align-self: stretch; margin: 2px 4px; border-left: 1px solid #808080; border-right: 1px solid #fff; }

    .address { display: flex; align-items: center; gap: 6px; padding: 3px 6px; }
    .addr-field { flex: 1; display: flex; align-items: center; gap: 4px; background: #fff; padding: 2px 4px; box-shadow: inset -1px -1px #fff, inset 1px 1px #808080, inset -2px -2px #dfdfdf, inset 2px 2px #0a0a0a; }
    .addr-field input { flex: 1; border: 0; box-shadow: none; padding: 0; height: auto; }

    .pane { flex: 1; min-height: 0; display: grid; grid-template-columns: 230px 1fr; gap: 0; margin: 0 4px 4px; }
    .webview { background: #fff; padding: 14px; overflow: auto; border: 2px inset #fff; border-right: 0; }
    .webview h2 { font-size: 32px; font-weight: normal; margin: 8px 0 4px; }
    .rule { height: 3px; background: linear-gradient(90deg, #000080, #1084d0 60%, transparent); margin-bottom: 10px; }
    .webview p { line-height: 1.5; }
    .detail { display: flex; flex-direction: column; gap: 2px; margin-top: 6px; }
    .detail .logo { width: 48px; height: 48px; object-fit: contain; margin-bottom: 6px; }
    .kv { display: flex; justify-content: space-between; border-bottom: 1px dotted #c0c0c0; padding: 2px 0; }
    .md :global(ul) { padding-left: 16px; margin: 6px 0; }
    .md :global(li), .md :global(p) { line-height: 1.5; margin-bottom: 4px; }
    .muted { color: #555; }
    .small { font-size: 16px; margin-top: 6px; }

    .main { overflow: auto; background: #fff; padding: 0; }
    .bigicons { list-style: none; margin: 0; padding: 16px; display: grid; grid-template-columns: repeat(auto-fill, 96px); gap: 10px; }
    .bigicon { all: unset; box-sizing: border-box; width: 96px; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 6px; cursor: pointer; text-align: center; color: #000; text-decoration: none; font-size: 16px; }
    .bigicon:hover span, .bigicon:focus span { background: #000080; color: #fff; outline: 1px dotted #000; }

    .details { width: 100%; border-collapse: collapse; }
    .details th { position: sticky; top: 0; background: #c0c0c0; text-align: left; font-weight: normal; padding: 4px 8px; box-shadow: inset -1px -1px #808080, inset 1px 1px #fff; }
    .details td { padding: 5px 8px; white-space: nowrap; }
    .details td:first-child .px-icon { display: inline-block; vertical-align: -3px; margin-right: 6px; }
    .details tr[data-row] { cursor: default; }
    .details tr.sel td, .details tr[data-row]:focus td { background: #000080; color: #fff; outline: none; }
    .details a { color: inherit; display: flex; align-items: center; gap: 6px; }
    .art { width: 24px; height: 24px; }

    .notepad { display: grid; grid-template-columns: 200px 1fr; gap: 16px; padding: 16px; }
    .notepad img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
    .notepad p { line-height: 1.4; margin: 0 0 12px; font-size: 16px; }

    .ugc { padding: 14px; }
    .ugc-banner { background: linear-gradient(90deg, #000080, #1084d0); color: #fff; padding: 10px 12px; font-size: 16px; }
    .ugc-banner b { font-size: 32px; font-weight: normal; }
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 10px 0; }
    .stat { display: flex; flex-direction: column; padding: 8px; background: #c0c0c0; box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff, inset -2px -2px #808080, inset 2px 2px #dfdfdf; }
    .stat b { font-size: 32px; font-weight: normal; line-height: 1; }
    .shots { display: grid; gap: 10px; }
    .shots figure { margin: 0; }
    .shots img { display: block; border: 2px inset #fff; }
    .shots figcaption { margin-top: 3px; }
    .brands { display: flex; flex-wrap: wrap; gap: 16px; }
    .brand { display: flex; gap: 8px; align-items: center; }
    .brand img { width: 32px; height: 32px; object-fit: cover; }
    .brand img.wordmark { width: auto; object-fit: contain; }
    .ugc p { line-height: 1.5; margin: 10px 0 0; }

    .music { padding: 12px; }
    .player { max-width: 520px; margin-bottom: 14px; }
    .screen { display: flex; gap: 12px; align-items: center; background: linear-gradient(180deg, #000, #102040); color: #9cf; padding: 10px; box-shadow: inset 1px 1px #808080, inset -1px -1px #fff; }
    .screen img { width: 72px; height: 72px; border: 1px solid #335; flex-shrink: 0; }
    .np-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
    .np-text a { color: #fff; font-weight: normal; font-size: 32px; line-height: 1; text-decoration: none; }
    .np-text a:hover { text-decoration: underline; }
    .np-label { color: #3f3; font-size: 16px; text-transform: uppercase; letter-spacing: 1px; }
    .np-album { color: #68a; }
    .eq { display: flex; align-items: flex-end; gap: 2px; height: 40px; }
    .eq i { width: 4px; height: 20%; background: linear-gradient(0deg, #0f0, #ff0 70%, #f00); }
    .player[data-state="playing"] .eq i { animation: eq 0.9s ease-in-out infinite alternate; }
    .eq i:nth-child(3n) { animation-duration: 0.6s; } .eq i:nth-child(4n) { animation-duration: 1.1s; } .eq i:nth-child(5n) { animation-delay: -0.3s; }
    @keyframes eq { from { height: 10%; } to { height: 100%; } }
    .seek { height: 6px; margin: 8px 2px; background: #fff; box-shadow: inset 1px 1px #808080, inset -1px -1px #fff; }
    .seek span { display: block; height: 100%; width: 0; background: #000080; }
    .player[data-state="playing"] .seek span { animation: seek 30s linear infinite; }
    @keyframes seek { to { width: 100%; } }
    .controls { display: flex; gap: 4px; align-items: center; }
    .controls button { min-width: 36px; }
    .controls a { margin-left: auto; }
    .group { margin: 16px 0 8px; font-size: 16px; font-weight: normal; border-bottom: 1px solid #808080; box-shadow: 0 1px #fff; padding-bottom: 3px; }
    .thumbs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 12px 10px; }
    .thumbs li { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
    .thumb { width: 100%; aspect-ratio: 1; padding: 4px; background: #fff; box-shadow: inset -1px -1px #fff, inset 1px 1px #808080, inset -2px -2px #dfdfdf, inset 2px 2px #0a0a0a; }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .thumbs span { font-size: 16px; line-height: 1.2; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .thumbs li:hover span { background: #000080; color: #fff; }
    .status-bar-field { display: flex; align-items: center; gap: 4px; }

    @media (max-width: 720px) {
        .bg { padding: 0; }
        .explorer { height: 100vh; height: 100dvh; }
        .menubar > span { display: none; }
        .pane { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
        .webview { border: 2px inset #fff; border-bottom: 0; max-height: 38vh; padding: 10px; }
        .webview h2 { font-size: 32px; margin-top: 0; }
        .hide-sm { display: none; }
        .details td { white-space: normal; }
        .notepad { grid-template-columns: 1fr; }
        .notepad img { aspect-ratio: 4 / 3; }
        .stats { grid-template-columns: 1fr 1fr 1fr; }
        .stat b { font-size: 16px; }
        .bigicons { grid-template-columns: repeat(3, 1fr); padding: 10px; }
        .bigicon { width: 100%; }
        .music { padding: 8px; }
        .thumbs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .eq { display: none; }
    }
</style>

<script>
    const views = [...document.querySelectorAll<HTMLElement>("[data-view]")];
    const sides = [...document.querySelectorAll<HTMLElement>("[data-side]")];
    const details = [...document.querySelectorAll<HTMLElement>("[data-detail]")];
    const sideDefault = document.getElementById("side-default")!;
    const sideTitle = document.getElementById("side-title")!;
    const addr = document.getElementById("addr") as HTMLInputElement;
    const titleText = document.getElementById("title-text")!;
    const back = document.getElementById("back") as HTMLButtonElement;
    const up = document.getElementById("up") as HTMLButtonElement;
    const count = document.getElementById("status-count")!;
    const sel = document.getElementById("status-sel")!;
    const names: Record<string, string> = { root: "Jordan Otomu", about: "About Me", experience: "Experience", projects: "Projects", ugc: "UGC", education: "Education", music: "Music" };
    // each folder change is a real history entry, so the browser's back
    // (and safari's swipe) steps through folders instead of leaving the site.
    // `depth` counts entries this visit pushed; the toolbar Back uses it too.
    let depth = 0;
    const current = () => views.find((v) => !v.hidden)?.dataset.view;
    const urlFor = (id: string) => (id === "root" ? location.pathname : `#/${id}`);
    const fromHash = () => location.hash.replace("#/", "") || "root";

    function go(id: string) {
        if (!names[id]) id = "root";
        if (id === current()) return;
        depth++;
        history.pushState({ view: id, depth }, "", urlFor(id));
        show(id);
    }

    function show(id: string) {
        if (!names[id]) id = "root";
        views.forEach((v) => (v.hidden = v.dataset.view !== id));
        sides.forEach((s) => (s.hidden = s.dataset.side !== id));
        details.forEach((d) => (d.hidden = true));
        document.querySelectorAll("tr.sel").forEach((r) => r.classList.remove("sel"));
        sideDefault.hidden = id !== "root";
        sideTitle.textContent = names[id];
        const path = id === "root" ? "C:\\Jordan Otomu" : `C:\\Jordan Otomu\\${names[id]}`;
        addr.value = path;
        titleText.textContent = path;
        back.disabled = depth === 0;
        up.disabled = id === "root";
        const view = views.find((v) => v.dataset.view === id)!;
        const n = view.querySelectorAll("tbody tr, .bigicon").length;
        count.textContent = n ? `${n} object(s)` : "";
        sel.textContent = "";
    }

    document.querySelectorAll<HTMLElement>("[data-go]").forEach((b) => b.addEventListener("click", () => go(b.dataset.go!)));
    back.addEventListener("click", () => { if (depth > 0) history.back(); });
    up.addEventListener("click", () => go("root"));
    addEventListener("popstate", (e) => {
        depth = e.state?.depth ?? 0;
        show(e.state?.view ?? fromHash());
    });

    document.querySelectorAll<HTMLElement>("tr[data-row]").forEach((row) => {
        const pick = () => {
            document.querySelectorAll("tr.sel").forEach((r) => r.classList.remove("sel"));
            row.classList.add("sel");
            details.forEach((d) => (d.hidden = d.dataset.detail !== row.dataset.row));
            sides.forEach((s) => (s.hidden = true));
            sel.textContent = row.querySelector("td")!.textContent ?? "";
            if (matchMedia("(max-width: 720px)").matches) document.querySelector(".webview")!.scrollTop = 0;
        };
        row.addEventListener("click", pick);
        row.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); pick(); } });
    });

    // media player: poll spotify now-playing; keep the on-repeat fallback if it's offline
    const player = document.getElementById("player")!;
    const npLabel = document.getElementById("np-label")!;
    async function pollNow() {
        try {
            const r = await fetch("/api/now-playing", { cache: "no-store" });
            if (!r.ok) throw new Error(String(r.status));
            const d = await r.json();
            if (!d.title) throw new Error("idle");
            (document.getElementById("np-art") as HTMLImageElement).src = d.albumArt;
            const title = document.getElementById("np-title") as HTMLAnchorElement;
            title.textContent = d.title;
            if (d.trackUrl) title.href = d.trackUrl;
            document.getElementById("np-artist")!.textContent = d.artist;
            document.getElementById("np-album")!.textContent = d.album ?? "";
            npLabel.textContent = d.isPlaying ? "● now playing on spotify" : "last played";
            player.dataset.state = d.isPlaying ? "playing" : "idle";
        } catch {
            npLabel.textContent = "on repeat";
            player.dataset.state = "idle";
        }
    }
    pollNow();
    setInterval(pollNow, 30_000);
    document.getElementById("np-play")!.addEventListener("click", () => {
        player.dataset.state = player.dataset.state === "playing" ? "idle" : "playing";
    });

    history.replaceState({ view: fromHash(), depth: 0 }, "", urlFor(fromHash()));
    show(fromHash());
</script>
