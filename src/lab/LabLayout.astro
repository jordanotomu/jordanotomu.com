---
import CursorTrail from "~/components/CursorTrail.astro";
// bare document shell for the 98.css pages (the explorer homepage and the
// /lab variants): chrome, favicon, cursor trail. lab pages stay noindex;
// pass `indexable` + `description` for a real page.
interface Props {
    title: string;
    description?: string;
    indexable?: boolean;
}
const { title, description, indexable = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://jordanotomu.com").toString();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        {indexable ? (
            <>
                {description && <meta name="description" content={description} />}
                <meta property="og:type" content="website" />
                <meta property="og:title" content={title} />
                {description && <meta property="og:description" content={description} />}
                <meta property="og:url" content={canonical} />
                <meta property="og:image" content="/assets/photos/jordan-dc.jpg" />
                <meta name="twitter:card" content="summary" />
                <link rel="canonical" href={canonical} />
            </>
        ) : (
            <meta name="robots" content="noindex" />
        )}
        <title>{title}</title>
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="stylesheet" href="https://unpkg.com/98.css@0.1.21/dist/98.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/win95fa@5.3.0/index.css" />
        <style is:global>
            :root { --ink: #000; }
            * { box-sizing: border-box; }
            [hidden] { display: none !important; }
            html, body { margin: 0; }
            img { max-width: 100%; }
            .px-icon { display: block; image-rendering: pixelated; flex-shrink: 0; }
        </style>
    </head>
    <body>
        <slot />
        <CursorTrail />
    </body>
</html>
