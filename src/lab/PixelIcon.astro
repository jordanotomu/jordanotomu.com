---
// original 16×16 pixel-art icons in a win9x palette, drawn as crisp svg rects.
// "pc" reuses the site favicon.
interface Props {
    name: "folder" | "folder-open" | "doc" | "pdf" | "cd" | "globe" | "mail" | "film" | "pc" | "trash" | "star" | "back" | "up";
    size?: number;
}
const { name, size = 32 } = Astro.props;

const P: Record<string, string> = {
    K: "#000000", W: "#ffffff", L: "#c0c0c0", D: "#808080",
    Y: "#ffe36e", O: "#c99a1e", V: "#fff6c2",
    R: "#c00000", B: "#0000c0", C: "#00a0ff", G: "#00a000", N: "#000080",
