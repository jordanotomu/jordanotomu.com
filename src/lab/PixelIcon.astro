// explorer toolbar arrows: solid black triangles (drawn, so ios can't turn them into emoji)
// both fill the same centered 10×10 box (3..12) so they line up side by side
G.back = Array.from({ length: 16 }, (_, y) => {
    if (y < 3 || y > 12) return ".".repeat(16);
    const start = 3 + Math.floor(Math.abs(y - 7.5)) * 2;
    return Array.from({ length: 16 }, (_, x) => (x >= start && x <= 12 ? "K" : ".")).join("");
});
G.up = Array.from({ length: 16 }, (_, y) => Array.from({ length: 16 }, (_, x) => G.back[15 - x][y]).join(""));

// round icons are generated: a cd and a globe
function circle(fill: (x: number, y: number, r: number) => string) {
    const rows: string[] = [];
    for (let y = 0; y < 16; y++) {
        let row = "";
        for (let x = 0; x < 16; x++) {
            const r = Math.hypot(x - 7.5, y - 7.5);
            row += r > 7.5 ? "." : r > 6.6 ? "K" : fill(x, y, r);
        }
        rows.push(row);
    }
    return rows;
}
G.cd = circle((x, y, r) => (r < 1.6 ? "." : r < 2.6 ? "K" : x + y < 12 ? (x < y ? "C" : "W") : r < 4 ? "L" : "W"));
const land = ["....GG..", "...GGGG.", "..GGG...", "......GG", ".....GGG", "GG....G.", "GGG.....", ".G......"];
G.globe = circle((x, y) => (land[(y >> 1) % 8][(x >> 1) % 8] === "G" ? "G" : "B"));

const grid = G[name];
const rects: { x: number; y: number; c: string }[] = [];
if (grid) grid.forEach((row, y) => [...row].forEach((ch, x) => ch !== "." && rects.push({ x, y, c: P[ch] })));
---

{name === "pc" ? (
    <img class="px-icon" src="/favicon-32.png" width={size} height={size} alt="" style="image-rendering: pixelated" />
) : (
    <svg class="px-icon" width={size} height={size} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
        {rects.map((r) => <rect x={r.x} y={r.y} width="1" height="1" fill={r.c} />)}
    </svg>
)}
